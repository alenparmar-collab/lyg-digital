# Copy to .env.local for local development. Never commit .env.local.
# In production these are set in the Vercel project's Environment Variables.
#
# The app reads nothing else from the environment. Miss one of the committee
# settings and the sign-in closes rather than opens.

# The Supabase project URL. Safe to expose.
# Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=

# SERVER ONLY. Never prefix anything below with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY bypasses every row level security rule, which is
# how the server reads member data and why it must never reach the browser.
# It is the only Supabase key the app uses: committee sign-in does not go
# through Supabase Auth, so no Supabase credential is sent to a browser at all.
SUPABASE_SERVICE_ROLE_KEY=

# Who may sign in, one entry per person, as a single line of JSON.
#
#   name      shown in the committee header. Required.
#   phone     +91 E.164. Required, and must not repeat another entry's.
#   password  at least 12 characters. Required.
#   view      "all" (default) sees the summary, the list and each record.
#             "summary" sees only the summary: no names, no numbers, no records.
#
# The whole list is rejected if any entry breaks a rule, and then nobody signs
# in. The reason is written to the server log; passwords never are.
COMMITTEE_USERS=[{"name":"Alen Parmar","phone":"+917567659834","password":"","view":"all"},{"name":"Fr ","phone":"+91","password":"","view":"summary"}]

# Signs the committee session cookie (HMAC-SHA256). 32+ random characters:
#   openssl rand -base64 32
# Changing it signs every committee session out at once.
COMMITTEE_SESSION_SECRET=

# FALLBACK, for the gap between deploying this and setting COMMITTEE_USERS.
# Used only when COMMITTEE_USERS is absent, and grants the full view. Delete
# both once the list above is in place.
# COMMITTEE_PHONE=+91
# COMMITTEE_PASSWORD=
