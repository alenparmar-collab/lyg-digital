# Copy to .env.local for local development. Never commit .env.local.
# In production these are set in the Vercel project's Environment Variables.
#
# These four are the whole list: the app reads nothing else from the
# environment. Miss one and the committee viewer closes rather than opens.

# Safe to expose: these two are sent to every visitor's browser.
# Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Never prefix these with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY bypasses every row level security rule, which is
# how the server reads member data and why it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Who may open /committee. A comma-separated list of email addresses, each one
# an account that already exists in Supabase Auth. An account gets in because
# its address is on this list, so removing an address removes the access.
COMMITTEE_EMAILS=
