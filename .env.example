# Copy to .env.local for local development. Never commit .env.local.
# In production these are set in the Vercel project's Environment Variables.
#
# These five are the whole list: the app reads nothing else from the
# environment. Miss one of the committee three and the sign-in closes rather
# than opens.

# The Supabase project URL. Safe to expose.
# Supabase -> Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=

# SERVER ONLY. Never prefix anything below with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY bypasses every row level security rule, which is
# how the server reads member data and why it must never reach the browser.
# It is the only Supabase key the app uses: since committee sign-in stopped
# going through Supabase Auth, no Supabase credential is sent to a browser at
# all, and the anon key is no longer read by any code.
SUPABASE_SERVICE_ROLE_KEY=

# The committee sign-in. One mobile number and one password, not an account
# list. The number is stored E.164, exactly as a member's number is.
COMMITTEE_PHONE=+91

# At least 12 characters. A shorter one is treated as no password at all and
# nobody gets in.
COMMITTEE_PASSWORD=

# Signs the committee session cookie (HMAC-SHA256). 32+ random characters:
#   openssl rand -base64 32
# Changing it signs every committee session out at once.
COMMITTEE_SESSION_SECRET=
